{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redcreekoutdoors",
  // Justin's Cloudflare account (same as backcountrydrones.com). Not a secret.
  "account_id": "cb84c27e835d7b5d6e0ae6f65af422cd",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    /* Assets are served before the Worker runs, and with 404-page handling a
       browser navigation to a path with no asset gets 404.html without the
       Worker ever seeing it. A plain form POST to /api/request would 404.
       Listing /api/* makes the Worker run first for those paths only.
       ADD A PATH HERE for any new Worker route a link or form must reach. */
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    // Interim, by Justin 2026-10-20: leads go to the Backcountry Drones ops
    // inbox until the Red Creek Workspace mailbox exists (runbook F7).
    "MAIL_TO": "ops@backcountrydrones.com",
    // Interim sender on the already-verified Backcountry Drones Resend domain.
    // Switch to "Red Creek Outdoors <site@send.redcreekoutdoors.com>" once
    // send.redcreekoutdoors.com is verified in Resend (runbook F7).
    "MAIL_FROM": "Red Creek Outdoors <site@send.backcountrydrones.com>"
  },

  // KV for leads, namespace "redcreekoutdoors-LEADS", created 2026-10-20.
  // The binding name MUST stay "LEADS" (worker/index.ts reads env.LEADS).
  "kv_namespaces": [{ "binding": "LEADS", "id": "dcc6a01d57414f56882f723369625450" }],

  "observability": { "enabled": true },

  /* NOT LIVE. workers.dev only until cutover (migration-runbook.md, step 6).
     Same method as backcountrydrones.com: zone routes, not a custom domain.
     The proxied apex A records keep pointing at GoDaddy (76.223.105.230,
     13.248.243.5) and the routes make Cloudflare answer from this Worker
     instead of reaching them. ROLLBACK: comment these out and redeploy; the
     GoDaddy site serves again within seconds.
  "routes": [
    { "pattern": "redcreekoutdoors.com/*", "zone_name": "redcreekoutdoors.com" },
    { "pattern": "www.redcreekoutdoors.com/*", "zone_name": "redcreekoutdoors.com" }
  ],
  */
  "workers_dev": true
}
