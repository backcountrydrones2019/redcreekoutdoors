{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redcreekoutdoors",
  // Justin's Cloudflare account (same as backcountrydrones.com). Not a secret.
  "account_id": "cb84c27e835d7b5d6e0ae6f65af422cd",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    /* The Worker runs first on every request (since cutover 2026-10-20) so it
       can 301 www to the apex; assets can't see the host. It hands everything
       else to env.ASSETS, which still applies _redirects, _headers and the
       404 page (tested locally before go-live). */
    "run_worker_first": true
  },

  "vars": {
    // Interim, by Justin 2026-10-20: leads go to the Backcountry Drones ops
    // inbox until the Red Creek Workspace mailbox exists (runbook F7).
    "MAIL_TO": "ops@backcountrydrones.com",
    // Interim sender on the already-verified Backcountry Drones Resend domain.
    // Switch to "Red Creek Outdoors <site@send.redcreekoutdoors.com>" once
    // send.redcreekoutdoors.com is verified in Resend (runbook F7).
    "MAIL_FROM": "Red Creek Outdoors <site@send.backcountrydrones.com>",
    // Facebook Page handle for the home page feed. The Page token is a secret:
    //   npx wrangler secret put FB_PAGE_TOKEN
    "FB_PAGE_ID": "redcreekoutdoorz",
    // TikTok has no account feed API. Paste video links here, comma
    // separated, newest first. Each is resolved by TikTok's public oEmbed.
    // Loaded 2026-10-20: the 10 newest posts on @redcreekoutdoors.
    "TIKTOK_VIDEOS": "https://www.tiktok.com/@redcreekoutdoors/video/7698128169269923086,https://www.tiktok.com/@redcreekoutdoors/video/7693169709365185805,https://www.tiktok.com/@redcreekoutdoors/video/7693168771233565965,https://www.tiktok.com/@redcreekoutdoors/video/7693167276861721870,https://www.tiktok.com/@redcreekoutdoors/video/7680902163920456973,https://www.tiktok.com/@redcreekoutdoors/video/7670376345368562958,https://www.tiktok.com/@redcreekoutdoors/video/7662331451135888653,https://www.tiktok.com/@redcreekoutdoors/video/7662330317864242446,https://www.tiktok.com/@redcreekoutdoors/video/7661277828087958798,https://www.tiktok.com/@redcreekoutdoors/video/7661277412046556430"
  },

  // Refreshes the social feed cache every two hours.
  "triggers": { "crons": ["0 */2 * * *"] },

  // KV for leads, namespace "redcreekoutdoors-LEADS", created 2026-10-20.
  // The binding name MUST stay "LEADS" (worker/index.ts reads env.LEADS).
  "kv_namespaces": [
    { "binding": "LEADS", "id": "dcc6a01d57414f56882f723369625450" },
    // Social feed cache, "redcreekoutdoors-SOCIAL", created 2026-10-20.
    { "binding": "SOCIAL", "id": "d7f754a4916d4937b01eee3a2a4a613e" }
  ],

  "observability": { "enabled": true },

  /* LIVE since 2026-10-20 (migration-runbook.md, Phase D). Zone routes, not a
     custom domain, same as backcountrydrones.com. The proxied apex A records
     still point at GoDaddy (76.223.105.230, 13.248.243.5); these routes make
     Cloudflare answer from this Worker instead. ROLLBACK: comment the routes
     out and push; the GoDaddy site serves again within seconds. */
  "routes": [
    { "pattern": "redcreekoutdoors.com/*", "zone_name": "redcreekoutdoors.com" },
    { "pattern": "www.redcreekoutdoors.com/*", "zone_name": "redcreekoutdoors.com" }
  ],
  "workers_dev": true
}
