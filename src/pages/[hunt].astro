---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import PagePhotos from '../components/PagePhotos.astro';
import { HUNTS } from '../data/hunts/index';
import { SITE, EQUIPMENT_RULE, HUNT_TOWNS } from '../consts';
import type { Hunt } from '../data/types';

export function getStaticPaths() {
  return HUNTS.map((h) => ({ params: { hunt: h.slug }, props: { h } }));
}

const { h } = Astro.props as { h: Hunt };
const crumbs = [
  { name: 'Guided Hunts', path: '/guided-hunts' },
  { name: h.name, path: `/${h.slug}` },
];
const others = HUNTS.filter((x) => x.slug !== h.slug);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: h.name,
    serviceType: 'Guided hunt',
    provider: { '@id': `${SITE.url}/#business` },
    areaServed: HUNT_TOWNS.map((t) => ({ '@type': 'City', name: `${t}, TX` })),
    ...(h.offers.length && { offers: h.offers.map((o) => ({
      '@type': 'Offer',
      name: o.name,
      priceCurrency: 'USD',
      price: o.amount,
      priceSpecification: { '@type': 'UnitPriceSpecification', price: o.amount, priceCurrency: 'USD', unitText: o.unit },
    })) }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: h.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base title={h.title} description={h.description} crumbs={crumbs} schema={schema}>
  <PageHero eyebrow="Guided hunt" title={h.h1} lede={h.lede} crumbs={crumbs}>
    <p class="price-line">{h.priceText}</p>
    <div class="btn-row">
      <a class="btn" href={`tel:${SITE.phoneE164}`}>Call {SITE.phone}</a>
      <a class="btn ghost" href="/contact">Request a date</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap prose">
      <table class="spec">
        <tbody>
          <tr><th>Price</th><td>{h.priceText}</td></tr>
          <tr><th>When</th><td>{h.whenShort}</td></tr>
          <tr><th>Where</th><td>Private land near {HUNT_TOWNS.slice(0, -1).join(', ')} and {HUNT_TOWNS[HUNT_TOWNS.length - 1]}</td></tr>
          <tr><th>Guns and ammo</th><td>{EQUIPMENT_RULE}</td></tr>
        </tbody>
      </table>

      <PagePhotos page={`/${h.slug}`} />

      {h.sections.map((s) => (
        <>
          <h2>{s.h2}</h2>
          {s.paras.map((p) => <p set:html={p} />)}
          {s.list && <ul class="checks">{s.list.map((li) => <li set:html={li} />)}</ul>}
        </>
      ))}

      {h.requirements.length > 0 && (
        <>
          <h2>What you need before you come</h2>
          <ul class="checks">
            {h.requirements.map((r) => (
              <li>{r.text} <a class="src" href={r.source.url}>({r.source.label})</a></li>
            ))}
          </ul>
          <p class="note">Agencies change rules. The agency page is the authority. Check it before you drive out. Digital license, paper tags, duck stamp on your phone: <a href="/faq">licenses and FAQ</a>.</p>
        </>
      )}

      <h2>Questions hunters ask</h2>
      <div class="faq">
        {h.faq.map((f) => (
          <details><summary>{f.q}</summary><p set:html={f.a} /></details>
        ))}
      </div>

      <h2>Other hunts</h2>
      <p>
        {others.map((o, i) => (
          <>{i > 0 && ' · '}<a href={`/${o.slug}`}>{o.name}</a></>
        ))}
        {' · '}<a href="/corporate-hunts">Corporate groups</a>
      </p>

      {h.sources.length > 0 && (
        <p class="sources">
          Sources:{' '}
          {h.sources.map((s, i) => (
            <>{i > 0 && '; '}<a href={s.url}>{s.label}</a></>
          ))}.
        </p>
      )}
    </div>
  </section>

  <CtaBand title={`Book a ${h.name.toLowerCase().replace(/s$/, '')}`} text="Call with your dates and how many are coming. We'll tell you what's open." />
</Base>

<style>
  .price-line { font: 700 1.25rem/1.3 var(--body); color: var(--red-dark); margin: 0.5rem 0 0; }
  .src { font-size: 0.85rem; color: var(--muted); }
  .note { font-size: 0.9rem; color: var(--muted); }
</style>
