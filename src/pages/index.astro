---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import TexasMap from '../components/TexasMap.astro';
import HuntMenu from '../components/HuntMenu.astro';
import SocialFeed from '../components/SocialFeed.astro';
import PhotoSlideshow from '../components/PhotoSlideshow.astro';
import { SITE, PRICES, COUNTIES, HUNT_TOWNS, SCALE } from '../consts';

const hunts = [
  { name: 'Thermal Hog Hunts', href: '/thermal-hog-hunts', price: PRICES.thermalHog.text, text: 'Night hunts under thermal optics on private ground where the hogs are doing real damage.' },
  { name: 'Thermal Predator Hunts', href: '/thermal-predator-hunts', price: PRICES.thermalPredator.text, text: 'Coyotes after dark under thermal, on ranches that want them gone.' },
  { name: 'Whitetail Deer', href: '/whitetail-deer-hunts', price: `${PRICES.whitetailDoe.text}. ${PRICES.whitetailBuck.text}.`, text: 'Guided doe and buck hunts on private Central Texas land during the Texas season.' },
  { name: 'Dove', href: '/dove-hunts', price: PRICES.dove.text, text: 'Central Zone, back open Dec. 11. Bring a shotgun or use ours.' },
  { name: 'Teal', href: '/teal-hunts', price: PRICES.teal.text, text: 'The September early season. 2026 is closed, booking 2027 now.' },
  { name: 'Duck', href: '/duck-hunts', price: PRICES.duck.text, text: 'North Zone regular season opens Nov. 14, 2026.' },
  { name: 'Goose', href: '/goose-hunts', price: PRICES.goose.text, text: 'Light and dark geese open Nov. 7, 2026 on both sides of I-35.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: `${SITE.url}/`,
  name: SITE.name,
  publisher: { '@id': `${SITE.url}/#business` },
};
---

<Base
  title="Hog Trapping & Guided Hunts in Killeen, TX | Red Creek Outdoors"
  description="Whole-sounder hog trapping for landowners and guided thermal, whitetail, dove and duck hunts on private Central Texas land. Call 254-397-8938."
  schema={schema}
>
  <section class="home-hero">
    <div class="wrap">
      <p class="eyebrow">Killeen, Texas · {COUNTIES.join(', ')} counties</p>
      <h1>Hog Trapping and Guided Hunts in Central Texas</h1>
      <p class="lede">
        Two jobs, same ground. We trap the whole sounder off your land, and we guide hunters on private ranches
        across Central Texas. One phone number for both.
      </p>
      <div class="btn-row hero-actions">
        <a class="btn" href="/hog-trap-request">Hog Trap Request</a>
        <HuntMenu id="hero-huntmenu" />
      </div>
      <p class="hero-call">Or call <a href={`tel:${SITE.phoneE164}`}>{SITE.phone}</a></p>
    </div>
  </section>

  <PhotoSlideshow />

  <section class="section">
    <div class="wrap grid two split">
      <div class="card">
        <p class="eyebrow">Landowners</p>
        <h2>Hogs on your place?</h2>
        <p>
          Shooting one pig at a time teaches the rest to run. We work the property, find where the sounder
          travels and feeds, get them comfortable, then take the group in one event with cellular traps we
          can see and trigger from a phone.
        </p>
        <p class="price">Trapping {PRICES.trapping.text.toLowerCase()}</p>
        <div class="btn-row">
          <a class="btn" href="/hog-trapping-service">How trapping works</a>
          <a class="btn ghost" href="/hog-trapping-killeen-tx">Hog trapping in Killeen</a>
        </div>
      </div>
      <div class="card">
        <p class="eyebrow">Hunters</p>
        <h2>Looking for a hunt?</h2>
        <p>
          Thermal hog and predator hunts at night, whitetail in season, and dove, teal and duck shoots on
          private ground near {HUNT_TOWNS.slice(0, -1).join(', ')} and {HUNT_TOWNS[HUNT_TOWNS.length - 1]}.
        </p>
        <p class="price">Hunts from $300</p>
        <div class="btn-row">
          <a class="btn" href="/guided-hunts">See every hunt</a>
          <a class="btn ghost" href="/corporate-hunts">Corporate groups</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Where we hunt and trap</h2>
      <p class="prose">
        Out of Killeen across Bell, Coryell, Milam and Falls counties and the country around them. Tap a town for what
        trapping looks like there, or see <a href="/hog-removal-areas">every area we cover</a>.
      </p>
      <TexasMap caption="Red Creek Outdoors trap and hunt country, Central Texas" />
    </div>
  </section>

  <section class="section sand">
    <div class="wrap">
      <h2>Guided hunts and starting prices</h2>
      <p class="prose">
        Prices are what we charge, on the page, before you call. Guns and ammo are there if you need them and the
        price doesn't change either way. You're paying for the ground and the hunt.
      </p>
      <div class="grid three">
        {hunts.map((h) => (
          <div class="card">
            <h3><a href={h.href}>{h.name}</a></h3>
            <p class="price">{h.price}</p>
            <p>{h.text}</p>
            <a class="more" href={h.href}>Details</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid two">
      <div class="prose">
        <h2>Why landowners call us</h2>
        <ul class="checks">
          <li>We go after the whole sounder. Leaving sows behind means the problem is back by spring.</li>
          <li>Cellular traps and cameras. We watch the trap live and close it when the group is inside, not when the first pig walks in.</li>
          {SCALE.hogsRemoved && <li>{SCALE.hogsRemoved} hogs trapped in {SCALE.hogsYear} so far (through {SCALE.hogsAsOf}).</li>}
          <li>{SCALE.acres} acres under our hunt and trap programs: ranches, ag ground and commercial solar sites across {COUNTIES.join(', ')} counties.</li>
          <li>One crew that both hunts and traps, so the property gets pressure from both directions.</li>
        </ul>
        <p><a href="/hog-removal-areas">See the towns and counties we cover</a></p>
      </div>
      <div class="prose">
        <h2>Ranch surveys, from the air</h2>
        <p>
          Before a trap goes up or a hunt gets planned, it helps to know what's actually on the ground. Our partner{' '}
          <a href={SITE.partner.url}>{SITE.partner.name}</a> flies the thermal surveys, builds the remote release
          hardware on our traps and runs the field cameras. We run the traps and the hunts.
        </p>
        <p><a href="/wildlife-surveys">How the surveys work</a></p>
      </div>
    </div>
  </section>

  <SocialFeed />

  <CtaBand />
</Base>

<style>
  .home-hero { background: var(--char-deep); color: #eee; padding: 4rem 0 4.25rem; border-bottom: 4px solid var(--red); }
  .home-hero h1 { color: #fff; max-width: 15ch; }
  .home-hero .lede { color: #d6d1cc; }
  .home-hero .eyebrow { color: #ff8a8d; }
  .light { color: #fff; border-color: #fff; }
  .hero-actions :global(.btn) { font-size: 1.1rem; padding: 1.05rem 1.6rem; }
  .hero-call { margin-top: 1rem; color: #d6d1cc; }
  .hero-call a { color: #fff; font-weight: 700; }
  .light:hover { background: #fff; color: var(--char-deep); }
  .split .card h2 { margin-top: 0; }
</style>
