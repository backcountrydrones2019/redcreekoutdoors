---
import { SITE } from '../consts';
interface Props { title?: string; text?: string; }
const {
  title = 'Call it in',
  text = "Tell us what you're after: a hunt date, or the hogs tearing up your place. We answer the phone.",
} = Astro.props;
---

<section class="section dark cta">
  <div class="wrap">
    <h2>{title}</h2>
    <p class="prose">{text}</p>
    <div class="btn-row">
      <a class="btn" href={`tel:${SITE.phoneE164}`}>Call {SITE.phone}</a>
      <a class="btn ghost light" href="/contact">Send a request</a>
    </div>
  </div>
</section>

<style>
  .cta h2 { margin-top: 0; }
  .light { color: #fff; border-color: #fff; }
  .light:hover { background: #fff; color: var(--char-deep); }
</style>
