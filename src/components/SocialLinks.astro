---
/* Facebook and TikTok links with inline icons. Used in the header, the mobile
   menu and the footer. Icons are inline SVG so nothing loads from Meta or
   TikTok just to draw a logo. */
import { SITE } from '../consts';
interface Props { size?: number; tone?: 'light' | 'dark'; labels?: boolean }
const { size = 22, tone = 'light', labels = false } = Astro.props;
const links = [
  {
    name: 'Facebook',
    href: SITE.social.facebook,
    path: 'M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.91 3.78-3.91 1.09 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.77-1.63 1.57v1.88h2.78l-.44 2.91h-2.34V22c4.78-.76 8.43-4.92 8.43-9.94Z',
  },
  {
    name: 'TikTok',
    href: SITE.social.tiktok,
    path: 'M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5 2.59 2.59 0 0 1-2.59-2.59 2.59 2.59 0 0 1 3.35-2.48V9.68a5.69 5.69 0 0 0-.76-.05A5.69 5.69 0 0 0 4.17 15.3a5.69 5.69 0 0 0 5.69 5.7 5.69 5.69 0 0 0 5.69-5.7V9.01a7.3 7.3 0 0 0 4.27 1.37V7.32a4.3 4.3 0 0 1-3.22-1.5Z',
  },
];
---

<ul class={`social ${tone}`}>
  {links.map((l) => (
    <li>
      <a href={l.href} rel="me noopener" target="_blank" aria-label={`Red Creek Outdoors on ${l.name}`}>
        <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true"><path d={l.path} fill="currentColor" /></svg>
        {labels && <span>{l.name}</span>}
      </a>
    </li>
  ))}
</ul>

<style>
  .social { list-style: none; display: flex; gap: 0.35rem; margin: 0; padding: 0; align-items: center; }
  .social li { margin: 0; }
  .social a { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.35rem; border-radius: var(--radius); text-decoration: none; font-weight: 600; }
  .light a { color: #e9e4df; }
  .light a:hover { color: #fff; background: rgba(255, 255, 255, 0.08); }
  .dark a { color: var(--char); }
  .dark a:hover { color: var(--red); }
</style>
